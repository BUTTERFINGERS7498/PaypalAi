{
  "$schema": "https://raw.githubusercontent.com/gmpetrov/agent-screenplay/main/schema/scenario.schema.json",
  "url": "http://localhost:8099/#console",
  "style": { "background": "blaze", "frame": "browser", "captions": true },
  "output": { "width": 1280, "height": 720, "fps": 24, "gif": true },
  "steps": [
    { "click": "role=tab[name='4. Disputes']", "say": "Now the honest part. The games console the rogue agent bought gets disputed too." },
    { "select": "label=Completed purchase", "option": "${GAME_PURCHASE_ID}" },
    { "click": "role=button[name='Create simulated dispute']" },
    { "wait": "role=button[name='Assemble evidence']", "hold": 1 },
    { "click": "role=button[name='Assemble evidence']", "say": "Same process, same evidence trail." },
    { "wait": "text=MANDATE BREACH", "hold": 1 },
    { "highlight": "text=MANDATE BREACH", "text": "Computed from the evidence, not argued", "say": "This time the verdict is mandate breach, and the action is to accept the claim. Sentry tells the truth instead of defending a bad purchase.", "hold": 4 }
  ]
}
