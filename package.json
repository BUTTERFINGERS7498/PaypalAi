{
  "name": "mandate-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Signed mandates and decision-time evidence for PayPal sandbox agent purchases",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "dev:server": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "dev:ui": "node --env-file-if-exists=.env scripts/dev-ui.ts",
    "build:ui": "node --env-file-if-exists=.env scripts/build-ui.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node --test e2e/*.test.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "ag-grid-community": "^33.3.2",
    "ag-grid-react": "^33.3.2",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3"
  }
}
