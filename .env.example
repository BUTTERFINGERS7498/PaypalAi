# Copy to .env locally. Never commit credentials. PayPal SANDBOX only.
# These defaults run without PayPal or Anthropic credentials.
PAYPAL_ENV=sandbox
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BUYER_EMAIL=
PAYPAL_WEBHOOK_ID=
WEBHOOK_VERIFY=off
# CHECKOUT_MODE: payer_approval = the buyer approves at PayPal | card = pay with PayPal's published sandbox test card
# (no buyer login, captured at once: lets a hosted demo run end to end, including refund on breach)
CHECKOUT_MODE=payer_approval
# APPROVAL_HOLD: off | authorize = hold the money at PayPal while a human decides (needs CHECKOUT_MODE=card)
APPROVAL_HOLD=off
# AGENT_MODE: live = Claude (needs ANTHROPIC_API_KEY) | mock = deterministic keyword parser (tests) | engine = on-server semantic
# engine, no external AI service and no key (downloads a ~23 MB open-source embedding model; run 'npm run build:engine' to fetch it).
# Optional engine settings (blank = defaults):
ENGINE_MODEL=
ENGINE_MODEL_DIR=
AGENT_MODE=mock
ANTHROPIC_API_KEY=
# Optional 9router gateway: http://localhost:20128
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional locally; set a private value before sharing a public instance.
APPROVAL_TOKEN=
# Protection for the agent endpoint (spends model quota and creates PayPal orders). Blank = defaults:
# 30 requests per client per hour and 300 per day overall against the real sandbox; off in mock mode. 0 disables.
AGENT_RATE_LIMIT_PER_HOUR=
AGENT_DAILY_LIMIT=
# Leave blank to generate and persist the demo signing key in SQLite.
MANDATE_SIGNING_KEY=
DATABASE_PATH=./data/mandate.db
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
# Public UI settings only; NEVER put a secret in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DATA_SOURCE=api
